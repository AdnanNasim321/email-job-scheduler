
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENDING
  PARTIAL
  SENT
  FAILED
  RATE_LIMITED
}

enum RecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id          String       @id @default(cuid())
  googleId    String?      @unique
  email       String       @unique
  name        String?
  avatarUrl   String?
  role        UserRole     @default(USER)
  senders     Sender[]
  emails      Email[]
  slackTokens SlackToken[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Sender {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAddress String
  displayName String?
  hourlyLimit Int      @default(0)
  emails      Email[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, fromAddress])
  @@index([userId])
}

model Email {
  id             String      @id @default(cuid())
  userId         String
  senderId       String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender         Sender      @relation(fields: [senderId], references: [id])
  subject        String
  body           String      @db.LongText
  status         EmailStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  failReason     String?     @db.Text
  idempotencyKey String      @unique
  bullJobId      String?
  sendingAt      DateTime?
  leaseToken     String?
  recipients     Recipient[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, status])
  @@index([senderId, status])
  @@index([status, sendingAt])
  @@index([scheduledAt])
}

model Recipient {
  id         String          @id @default(cuid())
  emailId    String
  email      Email           @relation(fields: [emailId], references: [id], onDelete: Cascade)
  address    String
  status     RecipientStatus @default(PENDING)
  sentAt     DateTime?
  failedAt   DateTime?
  failReason String?         @db.Text
  retryCount Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([emailId, address])
  @@index([emailId])
  @@index([emailId, status])
}

model SlackToken {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId         String
  teamName       String?
  botUserId      String?
  encryptedToken String   @db.Text
  tokenIv        String   @db.VarChar(64)
  tokenAuthTag   String   @db.VarChar(64)
  webhookUrl     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, teamId])
}
model OutboxEvent {
  id          String   @id @default(cuid())
  eventType   String
  payload     Json
  status      String   @default("PENDING")
  processedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}