
# Application
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MySQL Database
DATABASE_URL="mysql://YOUR_MYSQL_USER:YOUR_MYSQL_PASSWORD@localhost:3307/email_scheduler"

MYSQL_ROOT_PASSWORD=YOUR_ROOT_PASSWORD
MYSQL_DATABASE=email_scheduler
MYSQL_USER=YOUR_MYSQL_USER
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Authentication
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
SESSION_SECRET=replace_with_another_random_secret_at_least_32_characters

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Rate Limiting
SENDER_RATE_LIMIT_PER_HOUR=50
GLOBAL_RATE_LIMIT_PER_HOUR=500

# Worker
WORKER_CONCURRENCY=3
MIN_SEND_DELAY_MS=500
MAX_RECIPIENT_RETRIES=3

# Lease and Recovery
LEASE_TTL_MS=45000
HEARTBEAT_INTERVAL_MS=15000
RECOVERY_TIMEOUT_MS=120000
RECOVERY_POLL_MS=60000
